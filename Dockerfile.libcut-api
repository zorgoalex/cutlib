FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/LibCut.Core/LibCut.Core.csproj src/LibCut.Core/
COPY src/LibCut.Api/LibCut.Api.csproj src/LibCut.Api/
RUN dotnet restore src/LibCut.Api/LibCut.Api.csproj

COPY src/LibCut.Core/ src/LibCut.Core/
COPY src/LibCut.Api/ src/LibCut.Api/
RUN dotnet publish src/LibCut.Api/LibCut.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080

COPY --from=build /app/publish ./

ENTRYPOINT ["dotnet", "LibCut.Api.dll"]
